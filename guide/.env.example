# Ollama Configuration (Recommended - Free, Local, Private)
OLLAMA_MODEL=llama3.2
# Other options: llama3, mistral, codellama, phi, tinyllama
# Install Ollama from: https://ollama.ai

# OpenAI API Configuration (Optional - Paid)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4-turbo-preview

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=mars_knowledge

# Embedding Model
# Options: all-MiniLM-L6-v2 (fast), all-mpnet-base-v2 (better quality)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Whisper Model (for speech recognition)
# Options: tiny (fastest), base (recommended), small, medium, large (best quality)
WHISPER_MODEL=base

# NASA API (optional - for real-time data)
NASA_API_KEY=your_nasa_api_key_here

# RAG Configuration
RAG_TOP_K_RESULTS=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
